---
import "../styles/global.css";

const posts = [
  {
    title: "第一篇文章",
    description: "这里可以放思考、笔记、教程或长期写作。",
    href: "#writing",
  },
  {
    title: "图片记录",
    description: "整理旅行、日常、作品过程和灵感截图。",
    href: "#photos",
  },
  {
    title: "项目档案",
    description: "展示正在做、已经完成、或者值得保存的小项目。",
    href: "#projects",
  },
];

const projects = [
  "个人网站",
  "写作归档",
  "图片收藏",
  "工具实验",
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Freer 的个人网站，用来分享文章、图片、项目和一些正在形成的想法。"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Freer</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Freer</a>
      <nav aria-label="主导航">
        <a href="#writing">文章</a>
        <a href="#photos">图片</a>
        <a href="#projects">项目</a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div>
          <p class="eyebrow">freer.top</p>
          <h1 id="hero-title">记录文章、图片、项目，以及还在路上的想法。</h1>
          <p class="lede">
            这是 Freer 的个人网站。第一版先保持轻巧、稳定、可持续更新，之后再慢慢长出博客、相册和项目页。
          </p>
          <div class="actions">
            <a class="button primary" href="#writing">查看内容</a>
            <a class="button secondary" href="https://github.com/Freedempire/freer">GitHub</a>
          </div>
        </div>
      </section>

      <section class="section" id="writing" aria-labelledby="writing-title">
        <div class="section-heading">
          <p class="eyebrow">Writing</p>
          <h2 id="writing-title">文章</h2>
        </div>
        <div class="grid">
          {
            posts.map((post) => (
              <a class="card" href={post.href}>
                <h3>{post.title}</h3>
                <p>{post.description}</p>
              </a>
            ))
          }
        </div>
      </section>

      <section class="section split" id="photos" aria-labelledby="photos-title">
        <div class="section-heading">
          <p class="eyebrow">Photos</p>
          <h2 id="photos-title">图片</h2>
        </div>
        <div class="photo-wall" aria-label="图片占位区域">
          <div></div>
          <div></div>
          <div></div>
          <div></div>
        </div>
      </section>

      <section class="section" id="projects" aria-labelledby="projects-title">
        <div class="section-heading">
          <p class="eyebrow">Projects</p>
          <h2 id="projects-title">项目</h2>
        </div>
        <ul class="project-list">
          {projects.map((project) => <li>{project}</li>)}
        </ul>
      </section>
    </main>

    <footer>
      <span>© {new Date().getFullYear()} Freer</span>
      <a href="https://github.com/Freedempire/freer">Source</a>
    </footer>
  </body>
</html>
