---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import EntryList from "../components/EntryList.astro";
import { byDateDesc } from "../lib/content";

const articles = (await getCollection("articles")).sort(byDateDesc).slice(0, 4);
const notes = (await getCollection("notes")).sort(byDateDesc).slice(0, 4);
const projects = (await getCollection("projects")).sort(byDateDesc).slice(0, 3);

const sections = [
  {
    href: "/articles/",
    title: "articles",
    text: "技术文章、长文、教程、系统化思考。",
  },
  {
    href: "/projects/",
    title: "projects",
    text: "作品、实验、工具、长期维护的构件。",
  },
  {
    href: "/photos/",
    title: "photos",
    text: "图片、截图、扫描、视觉笔记和生活切片。",
  },
  {
    href: "/library/",
    title: "library",
    text: "公版书籍全文、整理版文本、阅读笔记。",
  },
];
---

<BaseLayout>
  <main class="page">
    <section class="home-hero" aria-labelledby="home-title">
      <div>
        <p class="kicker">index / anonymous static archive</p>
        <h1 id="home-title">文章、项目、图片、笔记与公版文本的私人索引。</h1>
        <p class="lede">
          这里不做社交名片，也不暴露个人资料。它更像一个长期维护的资料节点：
          内容优先，路径清晰，能被搜索、被引用、被反复打开。
        </p>
      </div>
      <pre class="terminal-readout" aria-label="站点索引状态"><strong>freer.top</strong>
├─ /articles   technical writing
├─ /projects   builds and experiments
├─ /photos     image fragments
├─ /notes      knowledge base
└─ /library    public domain texts

mode: static
stack: astro / markdown / cloudflare
signal: low noise, durable links</pre>
    </section>

    <section class="section" aria-labelledby="sections-title">
      <div class="section-head">
        <h2 id="sections-title">目录</h2>
      </div>
      <div class="taxonomy">
        {
          sections.map((section) => (
            <a href={section.href}>
              <strong>{section.title}</strong>
              <span>{section.text}</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="section" aria-labelledby="recent-articles">
      <div class="section-head">
        <h2 id="recent-articles">最近文章</h2>
        <a href="/articles/">view all</a>
      </div>
      <EntryList entries={articles} basePath="/articles/" label="最近文章" />
    </section>

    <section class="section" aria-labelledby="recent-notes">
      <div class="section-head">
        <h2 id="recent-notes">笔记</h2>
        <a href="/notes/">view all</a>
      </div>
      <EntryList entries={notes} basePath="/notes/" label="最近笔记" />
    </section>

    <section class="section" aria-labelledby="recent-projects">
      <div class="section-head">
        <h2 id="recent-projects">项目</h2>
        <a href="/projects/">view all</a>
      </div>
      <EntryList entries={projects} basePath="/projects/" label="最近项目" />
    </section>
  </main>
</BaseLayout>
