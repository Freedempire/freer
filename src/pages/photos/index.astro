---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { byDateDesc, formatDate } from "../../lib/content";

const photos = (await getCollection("photos")).sort(byDateDesc);
---

<BaseLayout title="photos" description="图片、截图、扫描和视觉笔记。">
  <main class="page">
    <header class="entry-header">
      <p class="kicker">collection / photos</p>
      <h1>photos</h1>
      <p class="summary">低频图片索引。它可以容纳生活记录、项目截图、图书扫描、视觉参考和过程材料。</p>
    </header>
    <section class="section">
      <div class="photo-grid">
        {
          photos.map((photo) => (
            <a
              class="photo-tile"
              href="#"
              style={
                photo.data.image
                  ? `background-color: ${photo.data.color}; background-image: linear-gradient(180deg, rgba(248, 248, 244, 0.08), rgba(17, 20, 19, 0.36)), url(${photo.data.image});`
                  : `background: ${photo.data.color}`
              }
            >
              <span>
                {formatDate(photo.data.date)}
                <br />
                {photo.data.title}
                <br />
                {photo.data.mood}
              </span>
            </a>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
