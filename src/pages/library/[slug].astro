---
import { getCollection, render } from "astro:content";
import EntryLayout from "../../layouts/EntryLayout.astro";
import { chaptersForBook, groupChaptersByPart, slugFromEntry } from "../../lib/library";

export async function getStaticPaths() {
  const entries = await getCollection("books");
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.mdx?$/, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const chapters = chaptersForBook(entry, await getCollection("chapters"));
const parts = groupChaptersByPart(chapters);
const bookSlug = slugFromEntry(entry);
---

<EntryLayout
  title={entry.data.title}
  description={entry.data.description}
  date={entry.data.date}
  tags={entry.data.tags}
  license={entry.data.license}
  copyright={entry.data.copyright}
  source={entry.data.source}
  collection="library"
>
  <Content />
  {
    parts.length > 0 && (
      <nav class="book-toc" aria-label="书籍目录">
        <h2>目录</h2>
        {parts.map((part) => (
          <section>
            <h3>{part.title}</h3>
            <ol>
              {part.chapters.map((chapter) => (
                <li>
                  <a href={`/library/${bookSlug}/${slugFromEntry(chapter)}/`}>
                    <span>
                      {chapter.data.chapterLabel ||
                        `Chapter ${chapter.data.chapterOrder}`}
                    </span>
                    <strong>{chapter.data.title}</strong>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </nav>
    )
  }
</EntryLayout>
