---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const siteTitle = "freer.top";
const { title = siteTitle, description = "一个用于文章、项目、图片、笔记和公版书籍的静态资料库。" } = Astro.props;
const pageTitle = title === siteTitle ? siteTitle : `${title} / ${siteTitle}`;

const nav = [
  { href: "/articles/", label: "articles" },
  { href: "/projects/", label: "projects" },
  { href: "/photos/", label: "photos" },
  { href: "/notes/", label: "notes" },
  { href: "/library/", label: "library" },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="freer.top home">freer.top</a>
      <nav aria-label="主导航">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <span>static archive</span>
      <span>cc0 / public domain / original notes</span>
    </footer>
  </body>
</html>
